NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=dev-only-change-me
TRUST_PROXY=0
LOG_LEVEL=info

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@academiave.local
