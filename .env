PAYMENT_DOCUMENT=V-12345678
EXCHANGE_RATE=0

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

MAX_RECEIPT_BYTES=8388608
MAX_IMAGE_BYTES=8388608
MAX_PDF_BYTES=20971520

# Optional absolute persistent paths (recommended for upgrades)
# DATA_DIR=/var/lib/academiave
# DB_FILE=/var/lib/academiave/academy.sqlite
# PUBLIC_UPLOAD_DIR=/var/lib/academiave/public

# Vídeos propios: FFmpeg y ffprobe deben estar instalados y disponibles.
# En Windows puedes indicar rutas completas a ffmpeg.exe y ffprobe.exe.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=1073741824
VIDEO_STORAGE_BYTES=21474836480
MAX_PROCESSED_VIDEO_BYTES=4294967296
MAX_VIDEO_DURATION_SECONDS=10800
VIDEO_PROCESSING_TIMEOUT_MS=14400000
# Una sola calidad consume menos espacio: VIDEO_HEIGHTS=720
VIDEO_HEIGHTS=720,480
# Mayor CRF reduce tamaño y calidad. Intervalo admitido: 18–35.
VIDEO_CRF=28
