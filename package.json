{
  "name": "academiave-platform",
  "version": "5.3.0",
  "private": true,
  "description": "AcademiaVE v5 - plataforma LMS modular con CMS por bloques, pagos manuales, progreso y certificados.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate-cli.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup.js",
    "verify:hotfix": "node scripts/verify-v5031.js",
    "test:browser": "node scripts/qa-browser.cjs",
    "restore": "node scripts/restore.js",
    "setup": "node scripts/setup.js",
    "check:video": "node scripts/check-video.js",
    "test:video-browser": "node scripts/qa-video.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1"
  }
}
